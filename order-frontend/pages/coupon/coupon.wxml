<view class="page">
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{current === item.status ? 'active' : ''}}"
      data-status="{{item.status}}"
      bindtap="switchTab"
    >{{item.name}}</view>
  </view>

  <block wx:if="{{list.length > 0}}">
    <view class="coupon-card {{item.status !== 0 ? 'disabled' : ''}}" wx:for="{{list}}" wx:key="id">
      <view class="coupon-left">
        <view class="coupon-amount">
          <text wx:if="{{item.type === 2}}" class="num">{{item.discountText}}</text>
          <text wx:else class="num">{{item.amount}}</text>
          <text class="unit">{{item.type === 2 ? '折' : '元'}}</text>
        </view>
        <view class="coupon-threshold">{{item.threshold > 0 ? '满' + item.threshold + '可用' : '无门槛'}}</view>
      </view>
      <view class="coupon-right">
        <view class="coupon-name">{{item.name}}</view>
        <view class="coupon-label">{{item.label}}</view>
        <view class="coupon-time">有效期至 {{item.endTime}}</view>
      </view>
      <view class="coupon-status">{{item.statusText}}</view>
    </view>
  </block>

  <view wx:else class="empty">
    <view class="empty-icon">🎫</view>
    <view class="empty-text">暂无优惠券</view>
    <view wx:if="{{current === 0}}" class="empty-btn" bindtap="goCenter">去领券中心</view>
  </view>

  <view class="bottom-space"></view>
</view>
