<!--pages/login/login.wxml —— 登录页（顾客=微信授权 / 店家=账号密码）-->
<view class="login-page">
  <view class="back" bindtap="goBack">‹ 返回</view>

  <view class="hero">
    <view class="logo">{{role === 'merchant' ? '🏪' : '🍔'}}</view>
    <view class="title">{{role === 'merchant' ? '店家登录' : '欢迎光临'}}</view>
    <view class="subtitle">{{role === 'merchant' ? '请使用店家账号密码登录' : '使用微信授权快速登录'}}</view>
    <view wx:if="{{tableNo}}" class="table-tag">当前桌号：{{tableNo}}</view>
  </view>

  <!-- ==================== 顾客端：微信授权登录 ==================== -->
  <view wx:if="{{role === 'customer'}}" class="panel">
    <view class="avatar-row">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-placeholder">＋</view>
      </button>
      <view class="avatar-tip">点击选择微信头像</view>
    </view>

    <view class="field">
      <view class="field-label">昵称</view>
      <input
        class="field-input"
        type="nickname"
        placeholder="请输入昵称"
        value="{{nickName}}"
        bindinput="onNicknameInput"
        bindblur="onNicknameInput"
      />
    </view>

    <button class="submit-btn wx-btn" loading="{{logging}}" bindtap="customerLogin">
      <text class="wx-icon">💬</text> 微信授权登录
    </button>

    <view class="hint">首次登录将自动创建账号，无需单独注册</view>
  </view>

  <!-- ==================== 店家端：账号密码登录 ==================== -->
  <view wx:else class="panel">
    <view class="field">
      <view class="field-label">账号</view>
      <input
        class="field-input"
        type="text"
        placeholder="请输入店家账号"
        value="{{username}}"
        bindinput="onUsernameInput"
      />
    </view>

    <view class="field">
      <view class="field-label">密码</view>
      <view class="pwd-wrap">
        <input
          class="field-input pwd-input"
          password="{{!showPassword}}"
          placeholder="请输入密码"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
        <view class="pwd-toggle" catchtap="togglePassword">{{showPassword ? '🙈' : '👁'}}</view>
      </view>
    </view>

    <button class="submit-btn merchant-btn" loading="{{logging}}" bindtap="merchantLogin">
      登 录
    </button>

    <view class="hint">店家账号由平台统一开通，暂不支持自助注册</view>
  </view>
</view>
