<view class="page">
  <view class="summary">
    <view class="summary-item">
      <view class="summary-value">{{goods.length}}</view>
      <view class="summary-label">商品总数</view>
    </view>
    <view class="summary-item">
      <view class="summary-value">{{onShelfCount}}</view>
      <view class="summary-label">在售中</view>
    </view>
  </view>

  <scroll-view class="cats" scroll-x enable-flex>
    <view
      class="cat {{activeCategory === 'all' ? 'active' : ''}}"
      data-id="all"
      bindtap="switchCategory"
    >全部</view>
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="cat {{activeCategory === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="switchCategory"
    >{{item.name}}</view>
  </scroll-view>

  <view
    class="goods-item"
    wx:for="{{list}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindlongpress="onGoodsLongPress"
  >
    <view class="thumb">
      <image wx:if="{{item.imageUrl}}" class="thumb-img" src="{{item.image}}" mode="aspectFill"></image>
      <text wx:else>{{item.image}}</text>
    </view>
    <view class="info">
      <view class="name">{{item.name}}</view>
      <view class="desc text-sub">{{item.desc}}</view>
      <view class="meta">
        <text class="price">¥{{item.price}}</text>
        <text class="stock text-sub">库存 {{item.stock}}</text>
        <text class="sales text-sub">月售 {{item.sales}}</text>
      </view>
    </view>
    <view class="actions">
      <view class="shelf-tag {{item.status ? 'on' : 'off'}}" data-id="{{item.id}}" catchtap="toggleShelf">
        {{item.status ? '已上架' : '已下架'}}
      </view>
      <view class="edit-btn" data-id="{{item.id}}" catchtap="editGoods">编辑</view>
      <view class="edit-btn price-btn" data-id="{{item.id}}" catchtap="editPrice">改价</view>
    </view>
  </view>

  <view wx:if="{{list.length === 0}}" class="empty">暂无商品，点击右下角新增</view>

  <view class="fab" bindtap="addGoods">＋</view>
</view>
